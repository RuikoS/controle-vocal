<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ============ AUTORISATIONS ============ -->

    <!-- Étape 1 : écoute de la voix (demandée à l'exécution sur Android 6+). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Étape 1 : notification permanente du service de premier plan (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Etape 1 : service de premier plan (ecoute continue en arriere-plan).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Obligatoire depuis Android 14 pour un service de premier plan de type micro. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!--
        Indispensable pour lister les applications installees : depuis Android 11,
        une application ne voit plus les autres par defaut. Sans cette permission,
        « ouvre Spotify » echouerait pour une raison incomprehensible.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!--
        Note : les autorisations des étapes suivantes (CALL_PHONE, SEND_SMS,
        BLUETOOTH_CONNECT, WRITE_SECURE_SETTINGS via ADB, QUERY_ALL_PACKAGES...)
        seront ajoutées au fur et à mesure, jamais en avance.
    -->

    <application
        android:name=".VoiceControlApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoiceControlApp">

        <!-- Écran d'accueil + assistant de configuration des autorisations. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Service de premier plan : maintiendra l'écoute vocale active.
            Ici (étape 1) il démarre et affiche la notification permanente ;
            la reconnaissance vocale sera branchée à l'étape suivante.
        -->
        <service
            android:name=".service.VoiceControlService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!--
            Service d'accessibilité : c'est lui qui donnera le contrôle réel du
            téléphone (ouvrir des applis, appuyer, défiler, déverrouiller).
            Il est protégé par BIND_ACCESSIBILITY_SERVICE : seul le système
            Android peut s'y connecter, et l'utilisateur doit l'activer
            manuellement dans Réglages > Accessibilité.
        -->
        <service
            android:name=".service.VoiceAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
